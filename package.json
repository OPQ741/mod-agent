{
  "name": "mod-agent",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript 实现的 AI Coding Agent CLI，形态对标 Claude Code。当前处于设计阶段，仓库主体是 VitePress 文档站。",
  "type": "module",
  "license": "ISC",
  "author": {
    "name": "OPQ741",
    "url": "https://github.com/OPQ741"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OPQ741/mod-agent.git"
  },
  "bugs": {
    "url": "https://github.com/OPQ741/mod-agent/issues"
  },
  "homepage": "https://opq741.github.io/mod-agent/",
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "cli",
    "agent",
    "typescript",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "docs": "vitepress dev docs --open",
    "docs:build": "vitepress build docs",
    "lint": "npm run lint:eslint && npm run lint:md && npm run lint:links && npm run lint:agents && npm run format:check",
    "lint:eslint": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:links": "node scripts/verify-doc-links.mjs",
    "lint:agents": "node scripts/verify-agents-md-commands.mjs",
    "lint:fix": "eslint . --fix && markdownlint-cli2 --fix \"**/*.md\" && prettier . --write",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
