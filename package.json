{
  "name": "mod-agent",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript 实现的 AI Coding Agent CLI，形态对标 Claude Code。",
  "type": "module",
  "license": "ISC",
  "author": {
    "name": "OPQ741",
    "url": "https://github.com/OPQ741"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OPQ741/mod-agent.git"
  },
  "bugs": {
    "url": "https://github.com/OPQ741/mod-agent/issues"
  },
  "homepage": "https://opq741.github.io/mod-agent/",
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "cli",
    "agent",
    "typescript",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "bin": {
    "mod": "dist/cli/main.js",
    "mod-agent": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "npm@10.9.2",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "docs": "vitepress dev docs --open",
    "docs:build": "vitepress build docs",
    "build": "tsc -p tsconfig.build.json",
    "cli": "node dist/cli/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "lint": "npm run lint:eslint && npm run lint:md && npm run lint:links && npm run lint:agents && npm run format:check",
    "lint:eslint": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:links": "node scripts/verify-doc-links.mjs",
    "lint:agents": "node scripts/verify-agents-md-commands.mjs",
    "lint:fix": "prettier . --write && eslint . --fix && markdownlint-cli2 --fix \"**/*.md\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.6.7"
  }
}
